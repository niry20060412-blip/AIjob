{
  "manifest_version": 3,
  "name": "AI 求职助手 - 岗位采集器",
  "version": "0.1.0",
  "description": "在招聘网站岗位详情页采集岗位信息，并导入 AI 求职投递助手。不会自动登录、自动投递或绕过平台限制。",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "采集岗位信息",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
